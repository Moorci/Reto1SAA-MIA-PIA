      "main": [[{ "node": "Responder OK", "type": "main", "index": 0 }]]
    },
    "Gmail: correo al cliente": {
      "main": [[{ "node": "Responder OK", "type": "main", "index": 0 }]]
    },
    "Sheets: lista no llamar": {
      "main": [[{ "node": "Responder OK", "type": "main", "index": 0 }]]
    },
    "Gmail: aviso al supervisor": {
      "main": [[{ "node": "Responder OK", "type": "main", "index": 0 }]]
    }
  },
